# Postgres defaults that every service can reuse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doordash_decider_dev
POSTGRES_PORT=5432

# Fastify API defaults
DD_DECIDER_API_PORT=4000
DD_DECIDER_DEV_DB_URL=postgres://postgres:postgres@postgres:5432/doordash_decider_dev
DD_DECIDER_TEST_DB_URL=postgres://postgres:postgres@postgres:5432/doordash_decider_test
DATABASE_URL=postgres://postgres:postgres@postgres:5432/doordash_decider_dev

# Decision engine defaults (shares the same Postgres instance)
DECISION_ENGINE_DB_URL=jdbc:postgresql://postgres:5432/doordash_decision_engine
DECISION_ENGINE_URL=http://decision-engine:8080

# Optional ML service
ML_SERVICE_URL=http://ml-service:8000
ENABLE_HYBRID_ML=false

# Feature flag defaults
ENABLE_ANALYTICS_API=true
VITE_ENABLE_ANALYTICS_UI=true
