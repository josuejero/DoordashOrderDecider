# API / frontend
NODE_ENV=development
PORT=4000
DD_DECIDER_DEV_DB_URL=postgres://postgres:postgres@localhost:5432/doordash_decider_dev
DD_DECIDER_TEST_DB_URL=postgres://postgres:postgres@localhost:5432/doordash_decider_test
DATABASE_URL=${DD_DECIDER_DEV_DB_URL}
ENABLE_ANALYTICS_API=true
ENABLE_HYBRID_ML=false
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=75
VITE_ENABLE_ANALYTICS_UI=true

# ML service / trainer
DD_DECIDER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/doordash_decider_dev
MODEL_PATH=./ml_service/model.pkl
MODEL_METADATA_PATH=./ml_service/model_metadata.json
MLFLOW_TRACKING_URI=http://localhost:5000

# Optional: version string surfaced in /api/health
APP_VERSION=dev
