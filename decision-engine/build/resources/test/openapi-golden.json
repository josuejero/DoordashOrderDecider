          },
          "estimatedMinutes" : {
            "type" : "integer",
            "format" : "int32"
          },
          "targetHourlyRate" : {
            "type" : "number"
          },
          "availableMinutes" : {
            "type" : "integer",
            "format" : "int32"
          },
          "shiftStartHHMM" : {
            "type" : "string"
          },
          "finishHHMM" : {
            "type" : "string"
          },
          "earnedSoFar" : {
