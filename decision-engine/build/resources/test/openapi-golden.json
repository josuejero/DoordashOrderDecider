          },
          "value" : {
            "type" : "object"
          }
        }
      },
      "QuoteDecision" : {
        "type" : "object",
        "properties" : {
          "netPayout" : {
            "type" : "number"
          },
          "requiredDollars" : {
            "type" : "number"
          },
          "projectedGrossPerHour" : {
            "type" : "number"
          },
          "projectedNetPerHour" : {
            "type" : "number"
          },
          "finishIso" : {
            "type" : "string",
            "format" : "date-time"
          }
