{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "dist-server/server",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "include": ["server/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist-server",
    "server/services/**/*.ts"
  ]
}
