{
  "name": "doordashorderdecider",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "dev:server": "tsx --tsconfig tsconfig.server.json server/index.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node dist-server/server/index.js",
    "db:migrate": "node -r dotenv/config ./node_modules/node-pg-migrate/bin/node-pg-migrate up -e dev",
    "db:migrate:test": "node-pg-migrate up --database-url-var DD_DECIDER_TEST_DB_URL",
    "db:rollback": "node-pg-migrate down -e dev",
    "db:seed": "tsx --tsconfig tsconfig.server.json server/seed.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:decision-mode": "vitest run --run src/components/__tests__/ProfileTab.test.tsx src/components/__tests__/DeciderShiftSection.test.tsx src/__tests__/App.decisionMode.test.tsx",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.2",
    "fastify": "5.6.2",
    "pg": "8.16.3",
    "prom-client": "15.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.1.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.6.0",
    "@types/pg": "8.15.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-istanbul": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "dotenv": "17.2.3",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "7.0.0",
    "eslint-plugin-react-refresh": "0.4.23",
    "globals": "^16.4.0",
    "jsdom": "27.0.0",
    "node-pg-migrate": "8.0.3",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.14",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "7.1.7",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "3.2.4",
    "workbox-background-sync": "7.4.0",
    "workbox-cacheable-response": "7.4.0",
    "workbox-core": "7.4.0",
    "workbox-expiration": "7.4.0",
    "workbox-precaching": "7.4.0",
    "workbox-routing": "7.4.0",
    "workbox-strategies": "7.4.0"
  }
}
